{
  "Routes": [
    {
      "DownstreamPathTemplate": "/.well-known/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "usermanagement-api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/.well-known/{everything}",
      "UpstreamHttpMethod": [ "GET" ],
      "UpstreamHeaderTransform": {
        "X-Forwarded-Host": "localhost:5000",
        "X-Forwarded-Proto": "http"
      },
      "DownstreamHeaderTransform": {
        "Location": "{DownstreamBaseUrl}, {BaseUrl}"
      }
    },
    {
      "DownstreamPathTemplate": "/connect/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "usermanagement-api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/connect/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "OPTIONS" ],
      "UpstreamHeaderTransform": {
        "X-Forwarded-Host": "localhost:5000",
        "X-Forwarded-Proto": "http"
      },
      "DownstreamHeaderTransform": {
        "Location": "{DownstreamBaseUrl}, {BaseUrl}"
      },
      "HttpHandlerOptions": {
        "AllowAutoRedirect": false
      }
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "fishdex-api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/fishdex/v1/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ]
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "usermanagement-api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/user/v1/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ]
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "aquahome-api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/aquahome/v1/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ]
    },
    {
      "UpstreamPathTemplate": "/storage/{everything}",
      "UpstreamHttpMethod": [ "GET", "PUT", "POST", "DELETE" ],
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "minio",
          "Port": 9000
        }
      ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}
