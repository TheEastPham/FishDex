{
  "Routes": [
    {
      "DownstreamPathTemplate": "/connect/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "usermanagement",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/connect/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "OPTIONS" ]
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "fishdex",
          "Port": 8081
        }
      ],
      "UpstreamPathTemplate": "/fishdex/v1/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ]
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "usermanagement",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/user/v1/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ]
    },
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "aquahome",
          "Port": 8082
        }
      ],
      "UpstreamPathTemplate": "/aquahome/v1/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://api.fishlover.org"
  }
}
