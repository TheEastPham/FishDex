{
  "ConnectionStrings": {
    "FishDexDb": "Host=localhost;Port=5433;Database=fishdex;Username=fishdex;Password=fishdex_local_pwd"
  },
  "JwtSettings": {
    "SecretKey": "YourVeryLongSecretKeyThatShouldBeAtLeast32CharactersLong!",
    "Issuer": "FishLover",
    "Audience": "FishLover",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "InternalSettings": {
    "ApiKey": ""
  },
  "OpenTelemetry": {
    "ServiceName": "FishDex.API",
    "ExportEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] {TraceId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AuthServer": {
    "Url": "http://localhost:8080",
    "Authority": "http://localhost:8080"
  },
  "AllowedHosts": "*",
  "FishDexSettings": {
    "LanguageTopCount": 10
  },
  "Storage": {
    "Provider": "r2",
    "ServiceUrl": "https://96d92702d5457b842c1f0ea11d0c016b.r2.cloudflarestorage.com",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": "system-image",
    "PresignedUrlExpiryMinutes": 60,
    "ForcePathStyle": false
  }
