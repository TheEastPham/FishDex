# Copy thành .env tại ~/app/.env trên Oracle VM
# KHÔNG commit file .env thật lên git

# GitHub Container Registry
GHCR_USERNAME=TheEastPham

# PostgreSQL
PG_USER=fishlover
PG_PASSWORD=change_me_strong_password

# Connection strings (Npgsql format)
USERMGMT_DB_CONN=Host=postgres;Port=5432;Database=usermanagement;Username=fishlover;Password=change_me_strong_password
FISHDEX_DB_CONN=Host=postgres;Port=5432;Database=fishdex;Username=fishlover;Password=change_me_strong_password
AQUAHOME_DB_CONN=Host=postgres;Port=5432;Database=aquahome;Username=fishlover;Password=change_me_strong_password

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_CONN=redis:6379,password=change_me_redis_password

# JWT — phải khớp giữa UserManagement (issuer) và các resource server
JWT_SECRET_KEY=change_me_min_32_chars_secret_key
JWT_ISSUER=FishLover
JWT_AUDIENCE=FishLover
JWT_EXPIRY_DAYS=7

# OpenIddict Issuer (domain thật của production, dùng HTTPS)
OIDC_ISSUER=https://api.yourdomain.com

# UserManagement — seeding & email
SEED_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change_me_strong_password
REQUIRE_INVITATION=false
EMAIL_API_KEY=re_your_resend_api_key

# Cloudflare R2 (object storage cho fish images)
R2_SERVICE_URL=https://<accountId>.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=system-image
