{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["fishlover", "loki", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "Loki stack health",
  "uid": "fishlover-loki-stack",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Scrape target up",
      "description": "So target Prometheus dang up. Thieu la co exporter chet.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 8 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "count(up == 1)", "instant": true, "legendFormat": "up" }
      ]
    },
    {
      "type": "stat",
      "title": "Streams trong Loki",
      "description": "So stream ingester dang giu. Tang vot bat thuong = cardinality no (label moi sai).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum(loki_ingester_memory_streams)", "instant": true, "legendFormat": "streams" }
      ]
    },
    {
      "type": "stat",
      "title": "Log lines/s vao Loki",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum(rate(loki_distributor_lines_received_total[$__rate_interval]))", "instant": true, "legendFormat": "lines/s" }
      ]
    },
    {
      "type": "stat",
      "title": "Promtail dropped/s",
      "description": "Khac 0 = log dang bi mat. Thuong do entry qua cu (>168h) hoac Loki tra 4xx/5xx.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.001 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum(rate(promtail_dropped_entries_total[$__rate_interval]))", "instant": true, "legendFormat": "dropped/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingest rate (lines/s va bytes/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "bytes/s" },
            "properties": [
              { "id": "unit", "value": "Bps" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum(rate(loki_distributor_lines_received_total[$__rate_interval]))", "legendFormat": "lines/s" },
        { "refId": "B", "editorMode": "code", "expr": "sum(rate(loki_distributor_bytes_received_total[$__rate_interval]))", "legendFormat": "bytes/s" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Promtail: sent vs dropped theo instance",
      "description": "instance vm1-prod = promtail VM1 (log 4 service BE), vm2-monitor = promtail VM2 (log monitoring stack).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "dropped.*" },
            "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ]
          }
        ]
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum by (instance) (rate(promtail_sent_entries_total[$__rate_interval]))", "legendFormat": "sent {{instance}}" },
        { "refId": "B", "editorMode": "code", "expr": "sum by (instance) (rate(promtail_dropped_entries_total[$__rate_interval]))", "legendFormat": "dropped {{instance}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Loki HTTP 4xx/5xx theo route",
      "description": "Loi route push = mat log. Loi route query = dashboard query sai hoac Loki qua tai.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum by (route, status_code) (rate(loki_request_duration_seconds_count{status_code=~\"4..|5..\"}[$__rate_interval]))", "legendFormat": "{{route}} {{status_code}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Distributor to ingester append failures",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "editorMode": "code", "expr": "sum(rate(loki_distributor_ingester_append_failures_total[$__rate_interval]))", "legendFormat": "failures/s" }
      ]
    },
    {
      "type": "logs",
      "title": "Loi cua chinh Loki / Promtail (LogQL)",
      "description": "Thay cho 2 panel {app=\"loki\"} cua dashboard cong dong 14055 - setup nay dung label service, khong co label app.",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "id": 9,
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "queryType": "range",
          "expr": "{service=~\"loki|promtail|promtail-vm2\"} | logfmt | level=~\"error|warn\""
        }
      ]
    }
  ]
}
