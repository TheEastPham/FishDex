# Copy thành .env tại ~/app/.env trên Oracle VM
# KHÔNG commit file .env thật lên git

# GitHub Container Registry
GHCR_USERNAME=TheEastPham

# PostgreSQL admin (dùng cho container, KHÔNG phải app user)
PG_ADMIN_PASSWORD=change_me_postgres_admin_password

# UserManagement DB credentials
UM_DB_USER=um_user
UM_DB_PASSWORD=change_me_usermgmt_password

# FishDex DB credentials
FD_DB_USER=fd_user
FD_DB_PASSWORD=change_me_fishdex_password

# AquaHome DB credentials
AH_DB_USER=ah_user
AH_DB_PASSWORD=change_me_aquahome_password

# Redis
REDIS_PASSWORD=change_me_redis_password
REDIS_CONN=redis:6379,password=change_me_redis_password

# JWT — phải khớp giữa UserManagement (issuer) và các resource server
JWT_SECRET_KEY=change_me_min_32_chars_secret_key
JWT_ISSUER=FishLover
JWT_AUDIENCE=FishLover
JWT_EXPIRY_DAYS=7

# OpenIddict Issuer (domain thật của production, dùng HTTPS)
OIDC_ISSUER=https://api.yourdomain.com

# UserManagement — seeding & email
SEED_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=change_me_strong_password
REQUIRE_INVITATION=false
EMAIL_API_KEY=re_your_resend_api_key

# Cloudflare R2 — FishDex (read-only presigned URLs, bucket: system-image)
FISHDEX_R2_SERVICE_URL=https://<accountId>.r2.cloudflarestorage.com
FISHDEX_R2_ACCESS_KEY=
FISHDEX_R2_SECRET_KEY=
FISHDEX_R2_BUCKET_NAME=system-image

# Cloudflare R2 — AquaHome (read+write, bucket: aquahome, key riêng)
AQUAHOME_R2_SERVICE_URL=https://96d92702d5457b842c1f0ea11d0c016b.r2.cloudflarestorage.com/aquahome
AQUAHOME_R2_ACCESS_KEY=
AQUAHOME_R2_SECRET_KEY=
AQUAHOME_R2_BUCKET_NAME=aquahome
AQUAHOME_R2_ENV=prod

# CORS — FE origin trên Cloudflare Pages (hoặc domain custom)
FE_ORIGIN=https://your-app.pages.dev

# Web Push VAPID (Epic 9.2) — gen bằng: npx web-push generate-vapid-keys
# PublicKey không bí mật (FE tự fetch qua API); PrivateKey LÀ secret, không commit
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@fishlover.org

# Internal API key — dùng cho mọi lời gọi service-to-service, đặt GIỐNG NHAU ở mọi service:
#   AquaHome.Worker → UserManagement  /api/push/send
#   AquaHome.Worker → FishDex         /api/market/ingest   (báo cá trong bể theo quốc gia)
# Map vào config: InternalSettings__ApiKey (UserManagement, FishDex) và
# UserManagement__InternalApiKey (AquaHome). Không expose các endpoint này qua API Gateway.
INTERNAL_API_KEY=change_me_internal_api_key

# ── Epic 11: Public Aquarium & Contest ──────────────────────────────────────
# YouTube Data API v3 — upload video contest + sync viewCount. OAuth 2.0 web-server flow,
# setup 1 lần cho channel FishLover. Để trống = tính năng contest fail êm (không crash).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Email nhận cảnh báo khi R2 staging video contest > 7GB
ADMIN_R2_WARNING_EMAIL=admin@yourdomain.com
