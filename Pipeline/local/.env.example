# ────────────────────────────────────────────────────────────────
# FishLover Local Dev — Shared Environment
# Copy thành .env trong cùng thư mục trước khi chạy:
#   cp .env.example .env
# Chạy toàn bộ stack:
#   docker compose -f docker-compose.local.yml up -d
# ────────────────────────────────────────────────────────────────

# ── JWT (phải khớp giữa tất cả services) ─────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars
JWT_ISSUER=FishLover
JWT_AUDIENCE=FishLover
JWT_EXPIRY_DAYS=7
JWT_EXPIRY_MINUTES=60

# ── UserManagement API ────────────────────────────────────────────
UM_DB_CONN=Host=usermanagement-db;Port=5432;Database=UserManagement;Username=usermanagement;Password=UserMgmt_Local_Pwd1!
REDIS_CONN=usermanagement-redis:6379
SEED_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@fishlover.local
INITIAL_ADMIN_PASSWORD=your_admin_password
REQUIRE_INVITATION=false
EMAIL_API_KEY=re_your_resend_api_key

# ── FishDex DB ────────────────────────────────────────────────────
POSTGRES_USER=fishdex
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=fishdex
FISHDEX_DB_CONN=Host=fishdex-db;Port=5432;Database=fishdex;Username=fishdex;Password=your_db_password

# ── pgAdmin ───────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@fishdex.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# ── MinIO ─────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
STORAGE_SERVICE_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=system-image

# ── AquaHome API ──────────────────────────────────────────────────
AQUAHOME_DB_CONN=Host=aquahome-db;Port=5432;Database=AquaHome;Username=aquahome;Password=AquaHome_Local_Pwd1!
AUTH_SERVER_URL=http://localhost:8080
AUTH_SERVER_AUTHORITY=http://usermanagement-api:8080
