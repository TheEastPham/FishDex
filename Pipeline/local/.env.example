# ────────────────────────────────────────────────────────────────
# FishLover Local Dev — Shared Environment
# Copy thành .env trong cùng thư mục trước khi chạy:
#   cp .env.example .env
# Chạy toàn bộ stack:
#   docker compose -f docker-compose.local.yml up -d
# ────────────────────────────────────────────────────────────────

# ── JWT (phải khớp giữa tất cả services) ─────────────────────────
JWT_SECRET_KEY=your_jwt_secret_key_min_32_chars
JWT_ISSUER=FishLover
JWT_AUDIENCE=FishLover
JWT_EXPIRY_MINUTES=60

# ── UserManagement API ────────────────────────────────────────────
UM_DB_CONN=Host=usermanagement-db;Port=5432;Database=UserManagement;Username=usermanagement;Password=UserMgmt_Local_Pwd1!
REDIS_CONN=usermanagement-redis:6379
SEED_INITIAL_ADMIN=true
INITIAL_ADMIN_EMAIL=admin@fishlover.local
INITIAL_ADMIN_PASSWORD=your_admin_password
REQUIRE_INVITATION=false
EMAIL_API_KEY=re_your_resend_api_key

# ── FishDex DB ────────────────────────────────────────────────────
POSTGRES_USER=fishdex
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=fishdex
FISHDEX_DB_CONN=Host=fishdex-db;Port=5432;Database=fishdex;Username=fishdex;Password=your_db_password

# ── pgAdmin ───────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@fishdex.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password

# ── Cloudflare R2 — FishDex (read-only, bucket: system-image) ────────
FISHDEX_STORAGE_SERVICE_URL=https://<accountId>.r2.cloudflarestorage.com
FISHDEX_STORAGE_ACCESS_KEY=<r2_access_key_id>
FISHDEX_STORAGE_SECRET_KEY=<r2_secret_access_key>
FISHDEX_STORAGE_BUCKET=system-image

# ── Cloudflare R2 — AquaHome (read+write, bucket: aquahome) ──────────
AQUAHOME_STORAGE_SERVICE_URL=https://<accountId>.r2.cloudflarestorage.com
AQUAHOME_STORAGE_ACCESS_KEY=<r2_access_key_id>
AQUAHOME_STORAGE_SECRET_KEY=<r2_secret_access_key>
AQUAHOME_STORAGE_BUCKET=aquahome
AQUAHOME_STORAGE_ENV=dev

# ── AquaHome API ──────────────────────────────────────────────────────
AQUAHOME_DB_CONN=Host=aquahome-db;Port=5432;Database=AquaHome;Username=aquahome;Password=AquaHome_Local_Pwd1!
AUTH_SERVER_URL=http://localhost:8080
AUTH_SERVER_AUTHORITY=http://usermanagement-api:8080

# ── Web Push (Epic 9.2) — gen: npx web-push generate-vapid-keys ──────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@fishlover.org
# Internal API key — dùng chung cho UM <-> AquaHome khi gọi /api/push/send (local đặt chuỗi bất kỳ)
INTERNAL_API_KEY=dev-internal-key

# ── YouTube Data API v3 (Epic 11.3 — contest video upload + viewCount sync) ──
# OAuth 2.0 web-server flow, setup 1 lần cho channel FishLover:
# https://developers.google.com/identity/protocols/oauth2/web-server
# Không có key thật thì confirm-upload/approve/reject contest sẽ fail êm (log warning, không crash service)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# ── R2 storage guard cảnh báo (Epic 11.2) — chưa có worker gửi email, để sẵn key ──
ADMIN_R2_WARNING_EMAIL=admin@fishlover.local
