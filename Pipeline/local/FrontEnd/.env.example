# Copy thành .env trước khi docker compose up
# Các giá trị này được Vite inline tại BUILD TIME — không dùng environment: trong compose.
# Đổi biến thì phải build lại image (--build), restart container không ăn thua.
#
# Tên biến phải khớp FrontEnd/apps/aquahome-web/.env.example và args: trong
# docker-compose.yml cùng thư mục — sai tên thì build vẫn xanh nhưng app chạy sai config.

VITE_GATEWAY_URL=http://localhost:5000
VITE_AUTH_CLIENT_ID=aquahome-fe
VITE_AUTH_REDIRECT_URI=http://localhost:3000/callback
VITE_AUTH_POST_LOGOUT_URI=http://localhost:3000

# Basemap CARTO — lấy free tại https://carto.com/basemaps/apikey
# Để trống thì map fallback sang OSM tiles (nền sáng invert bằng CSS), vẫn chạy.
VITE_CARTO_API_KEY=xxxxx
