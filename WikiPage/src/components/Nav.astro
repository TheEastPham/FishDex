---
const navLinks = [
  { href: '/about',    label: 'About' },
  { href: '/products', label: 'Products' },
  { href: '/tech',     label: 'Tech' },
  { href: '/roadmap',  label: 'Roadmap' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav">
  <div class="nav__inner container">
    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="FishLover home">
      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="32" height="32" rx="8" fill="#1E293B"/>
        <path d="M26 13l-4 3 4 3V13z" fill="#10B981"/>
        <ellipse cx="15.5" cy="16" rx="7" ry="6" fill="#10B981"/>
        <circle cx="18.5" cy="14" r="1.5" fill="#0F172A"/>
      </svg>
      <span>FishLover</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="nav__links" aria-label="Main navigation">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': currentPath.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile toggle -->
    <button class="nav__toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="nav-mobile" aria-hidden="true">
    {navLinks.map(link => (
      <a href={link.href} class="nav__mobile-link">{link.label}</a>
    ))}
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--c-border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--c-white);
    letter-spacing: -0.02em;
    flex-shrink: 0;
    transition: opacity var(--t-fast);
  }
  .nav__logo:hover { opacity: 0.85; }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
  }

  .nav__link {
    padding: 0.5rem 0.875rem;
    border-radius: var(--r-md);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--c-text-muted);
    transition: all var(--t-fast);
  }
  .nav__link:hover {
    color: var(--c-text);
    background: var(--c-surface);
  }
  .nav__link--active {
    color: var(--c-nature);
    background: var(--c-nature-dim);
  }

  /* Hamburger */
  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.5rem;
    margin-left: auto;
  }
  .nav__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-text-muted);
    border-radius: 1px;
    transition: all var(--t-normal);
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .nav__toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */
  .nav__mobile {
    display: none;
    flex-direction: column;
    padding: 1rem var(--content-pad) 1.25rem;
    border-top: 1px solid var(--c-border);
    background: var(--c-surface);
    gap: 0.25rem;
  }
  .nav__mobile[aria-hidden="false"] {
    display: flex;
  }
  .nav__mobile-link {
    padding: 0.75rem 1rem;
    border-radius: var(--r-md);
    font-weight: 600;
    color: var(--c-text-muted);
    transition: all var(--t-fast);
  }
  .nav__mobile-link:hover {
    background: var(--c-surface-2);
    color: var(--c-text);
  }

  @media (max-width: 768px) {
    .nav__links { display: none; }
    .nav__toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.setAttribute('aria-hidden', String(isOpen));
  });
</script>
