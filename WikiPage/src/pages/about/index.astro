---
import BaseLayout from '../../layouts/BaseLayout.astro';

const chapters = [
  {
    href: '/about/philosophy',
    num: '01',
    title: 'Philosophy',
    desc: 'Các nguyên tắc hướng dẫn mọi quyết định — từ chất lượng dữ liệu đến thiết kế giao diện.',
    vp: 'vp--tank',
    accent: 'var(--c-ai)',
  },
  {
    href: '/about/story',
    num: '02',
    title: 'Câu chuyện',
    desc: 'Tại sao FishLover ra đời — từ tuổi thơ ở làng quê đến một dự án phần mềm cá nhân.',
    vp: 'vp--ocean',
    accent: 'var(--c-nature)',
  },
];

const stats = [
  { value: '35,000+', label: 'loài cá ghi nhận' },
  { value: '100%',    label: 'mã nguồn mở' },
  { value: '0đ',      label: 'hoàn toàn miễn phí' },
];
---

<BaseLayout
  title="Về dự án — FishLover"
  description="Nguồn gốc, philosophy, và câu chuyện phía sau dự án FishLover."
>

  <!-- ── About Hero ── -->
  <section class="about-hero">
    <div class="container">
      <div class="about-hero__inner">

        <div class="about-hero__text reveal">
          <span class="eyebrow">Về dự án</span>
          <h1>Tại sao FishLover tồn tại</h1>
          <div class="divider"></div>
          <p class="about-hero__lead">
            Nuôi cá đúng cách không dễ như nhiều người nghĩ. FishLover ra đời
            từ sự khó chịu thực tế — khi dữ liệu sinh thái rải rác, không
            nhất quán, và không có tiếng Việt.
          </p>
          <div class="about-hero__stats">
            {stats.map(s => (
              <div class="about-stat">
                <span class="about-stat__value">{s.value}</span>
                <span class="about-stat__label">{s.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="about-hero__visual reveal reveal-delay-2">
          <div class="vp vp--about" style="position:absolute;inset:0;"></div>
          <div class="about-hero__caption">Dữ liệu sinh thái · Mã nguồn mở</div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Chapter Cards ── -->
  <section class="section section--surface">
    <div class="container">

      <div class="section-header reveal">
        <span class="eyebrow">Khám phá</span>
        <h2>Hai khía cạnh của dự án</h2>
        <div class="divider"></div>
      </div>

      <div class="chapter-grid">
        {chapters.map((c, i) => (
          <a
            href={c.href}
            class={`chapter-card reveal reveal-delay-${i + 1}`}
            style={`--card-accent: ${c.accent};`}
          >
            <div class="chapter-card__visual">
              <div class={`vp ${c.vp}`} style="position:absolute;inset:0;"></div>
              <div class="chapter-card__visual-overlay" aria-hidden="true"></div>
              <span class="chapter-card__num">{c.num}</span>
            </div>
            <div class="chapter-card__body">
              <h3 class="chapter-card__title">{c.title}</h3>
              <p class="chapter-card__desc text-muted">{c.desc}</p>
              <span class="chapter-card__cta">Đọc thêm →</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .about-hero {
    padding-block: clamp(5rem, 10vw, 8rem);
    overflow: hidden;
  }

  .about-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: center;
  }

  .about-hero__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about-hero h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.03em;
    margin-block: 1rem 1.25rem;
  }

  .about-hero__lead {
    font-size: var(--text-lg);
    color: var(--c-text-muted);
    max-width: 44ch;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  .about-hero__stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
    width: 100%;
  }

  .about-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .about-stat__value {
    font-size: var(--text-2xl);
    font-weight: 900;
    color: var(--c-nature);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .about-stat__label {
    font-size: var(--text-xs);
    color: var(--c-text-dim);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .about-hero__visual {
    position: relative;
    border-radius: var(--r-2xl);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--c-border);
  }

  .about-hero__caption {
    position: absolute;
    bottom: 1.25rem;
    left: 1.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.4);
    z-index: 1;
  }

  @media (max-width: 768px) {
    .about-hero__inner { grid-template-columns: 1fr; }
    .about-hero__visual { aspect-ratio: 16 / 9; }
    .about-hero__stats { gap: 1.5rem; }
  }

  /* ── Chapter Cards ── */
  .chapter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .chapter-card {
    display: flex;
    flex-direction: column;
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-2xl);
    overflow: hidden;
    transition: border-color var(--t-normal), transform var(--t-normal), box-shadow var(--t-normal);
  }

  .chapter-card:hover {
    border-color: var(--card-accent, var(--c-nature));
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }

  .chapter-card__visual {
    position: relative;
    height: 240px;
    overflow: hidden;
  }

  .chapter-card__visual-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 40%, rgba(15,23,42,0.7) 100%);
    pointer-events: none;
  }

  .chapter-card__num {
    position: absolute;
    top: 1.25rem;
    left: 1.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.55);
    z-index: 1;
  }

  .chapter-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 1.75rem 2rem;
    flex: 1;
  }

  .chapter-card__title {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--c-white);
    line-height: 1.2;
  }

  .chapter-card__desc {
    font-size: var(--text-sm);
    line-height: 1.75;
    flex: 1;
  }

  .chapter-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--card-accent, var(--c-nature));
    margin-top: 0.5rem;
  }
</style>
