---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Philosophy — About — FishLover"
  description="Triết lý và nguyên tắc thiết kế của dự án FishLover."
>
  <section class="section">
    <div class="container" style="max-width:720px;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/about">Về dự án</a> <span>/</span>
        <span>Philosophy</span>
      </nav>

      <div class="section-header" style="margin-top:2rem;">
        <span class="eyebrow">Nguyên tắc</span>
        <h1>Philosophy</h1>
        <div class="divider"></div>
      </div>

      <!-- Philosophy content is TBD — owner has not defined it yet -->
      <div class="card" style="padding:2rem;">
        <p class="text-muted" style="font-size:var(--text-base); line-height:1.75;">
          Nội dung đang được chuẩn bị. Trang này sẽ phản ánh triết lý thiết kế
          của dự án — do owner định nghĩa, không phải AI generate.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--c-text-dim);
  }
  .breadcrumb a { color: var(--c-text-muted); transition: color var(--t-fast); }
  .breadcrumb a:hover { color: var(--c-nature); }
</style>
