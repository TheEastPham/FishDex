---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AquaHome — Products — FishDex"
  description="AquaHome: aquarium management app for tracking tanks, fish inventory, and water parameters."
>
  <section class="section">
    <div class="container" style="max-width:820px;">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span>/</span>
        <a href="/products">Products</a> <span>/</span>
        <span>AquaHome</span>
      </nav>

      <div class="section-header" style="margin-top:2rem;">
        <span class="eyebrow badge badge--primary">Aquarium Tracker</span>
        <h1 style="margin-top:0.75rem;">AquaHome</h1>
        <div class="divider"></div>
        <p>Track your aquariums, manage fish inventory, and log water parameters — all in one place.</p>
      </div>

      <!-- TODO: expand with screenshots, feature list, app link -->
      <div class="placeholder-content card">
        <p class="text-muted">Full product page coming soon. Will include: feature walkthrough, app screenshots, and links to the live AquaHome app.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--c-text-dim);
  }
  .breadcrumb a { color: var(--c-text-muted); transition: color var(--t-fast); }
  .breadcrumb a:hover { color: var(--c-primary); }

  .placeholder-content { padding: 2rem; }
</style>
