---
import BaseLayout from '../layouts/BaseLayout.astro';

const phases = [
  {
    phase: 'Phase 1–2',
    label: 'Done',
    status: 'done',
    title: 'Core Platform',
    items: [
      'FishDex species DB with FishBase data',
      'pgvector semantic search',
      'AquaHome CRUD (aquariums, fish inventory)',
      'OAuth2 PKCE auth (OpenIddict)',
      'Ocelot API gateway',
      'Docker Compose for local dev',
    ],
  },
  {
    phase: 'Phase 3–4',
    label: 'In Progress',
    status: 'active',
    title: 'Frontend & AI',
    items: [
      'AquaHome React web app',
      'Fish Search UI with debounced search',
      'Species detail page (ecology, conservation, occurrence map)',
      'AI Chat widget (SSE streaming)',
      'Image recognition search',
      'Visual identity alignment',
    ],
  },
  {
    phase: 'Phase 5+',
    label: 'Upcoming',
    status: 'upcoming',
    title: 'Growth & Community',
    items: [
      'Mobile app (React Native)',
      'Community media uploads + moderation',
      'Blog / editorial content',
      'Expanded geographic coverage',
      'Species compatibility recommendations',
    ],
  },
];
---

<BaseLayout
  title="Roadmap — FishDex"
  description="FishDex development roadmap: what's done, what's in progress, and what's coming next."
>
  <section class="section">
    <div class="container" style="max-width:820px;">
      <div class="section-header">
        <span class="eyebrow">Roadmap</span>
        <h1>Where we're going</h1>
        <div class="divider"></div>
        <p>FishDex is built in phases. Here's the plan — past, present, and future.</p>
      </div>

      <div class="timeline">
        {phases.map(p => (
          <div class:list={['timeline-item', `timeline-item--${p.status}`]}>
            <div class="timeline-item__marker" aria-hidden="true">
              {p.status === 'done'     && '✓'}
              {p.status === 'active'   && '◉'}
              {p.status === 'upcoming' && '○'}
            </div>
            <div class="timeline-item__content">
              <div class="timeline-item__header">
                <span class="timeline-item__phase">{p.phase}</span>
                <span class:list={['timeline-item__label', `timeline-item__label--${p.status}`]}>{p.label}</span>
              </div>
              <h3 class="timeline-item__title">{p.title}</h3>
              <ul class="timeline-item__list">
                {p.items.map(item => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 19px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    background: var(--c-border-md);
  }

  .timeline-item {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 1.25rem;
    padding-bottom: 2.5rem;
    position: relative;
  }

  .timeline-item:last-child { padding-bottom: 0; }

  .timeline-item__marker {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-sm);
    font-weight: 900;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .timeline-item--done .timeline-item__marker {
    background: var(--c-nature-dim);
    color: var(--c-nature);
    border: 2px solid rgba(16,185,129,0.3);
  }
  .timeline-item--active .timeline-item__marker {
    background: var(--c-primary-dim);
    color: var(--c-primary);
    border: 2px solid rgba(14,165,233,0.4);
    box-shadow: 0 0 16px rgba(14,165,233,0.2);
  }
  .timeline-item--upcoming .timeline-item__marker {
    background: var(--c-surface);
    color: var(--c-text-dim);
    border: 2px solid var(--c-border-md);
  }

  .timeline-item__content {
    padding-top: 0.5rem;
  }

  .timeline-item__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .timeline-item__phase {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text-dim);
  }

  .timeline-item__label {
    font-size: var(--text-xs);
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .timeline-item__label--done {
    background: var(--c-nature-dim);
    color: var(--c-nature);
  }
  .timeline-item__label--active {
    background: var(--c-primary-dim);
    color: var(--c-primary);
  }
  .timeline-item__label--upcoming {
    background: var(--c-surface-2);
    color: var(--c-text-dim);
  }

  .timeline-item__title {
    font-size: var(--text-2xl);
    margin-bottom: 1rem;
  }

  .timeline-item__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .timeline-item__list li {
    font-size: var(--text-sm);
    color: var(--c-text-muted);
    padding-left: 1.25rem;
    position: relative;
  }

  .timeline-item__list li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--c-text-dim);
  }

  .timeline-item--upcoming .timeline-item__list li {
    opacity: 0.6;
  }
</style>
