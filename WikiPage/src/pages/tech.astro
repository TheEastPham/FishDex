---
import BaseLayout from '../layouts/BaseLayout.astro';

const stack = [
  {
    layer: 'API Gateway',
    tech: 'Ocelot',
    desc: 'Routes requests across microservices. Single entry point for all client traffic.',
    badge: 'primary',
  },
  {
    layer: 'Backend Services',
    tech: '.NET 9 · Autofac',
    desc: 'Three isolated services: UserManagement (auth), FishDex (species data), AquaHome (aquarium tracking).',
    badge: 'nature',
  },
  {
    layer: 'Database',
    tech: 'PostgreSQL 16 + pgvector',
    desc: 'Relational data + vector embeddings in one engine. pgvector enables semantic similarity search without a separate vector DB.',
    badge: 'ai',
  },
  {
    layer: 'Data Source',
    tech: 'FishBase .parquet files',
    desc: 'Raw species data from FishBase loaded via Parquet format — structured, efficient, reproducible.',
    badge: 'nature',
  },
  {
    layer: 'Auth',
    tech: 'OpenIddict · OAuth2 PKCE',
    desc: 'Standards-based auth. No client secrets in the browser. PKCE flow for the web frontend.',
    badge: 'primary',
  },
  {
    layer: 'Observability',
    tech: 'OpenTelemetry · Prometheus',
    desc: 'Distributed tracing and metrics across all services. Ready for Grafana dashboards.',
    badge: 'ai',
  },
];
---

<BaseLayout
  title="Technology — FishDex"
  description="The technical architecture behind FishDex: .NET 9 microservices, pgvector semantic search, OpenTelemetry, and Ocelot gateway."
>
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Engineering</span>
        <h1>How FishDex is built</h1>
        <div class="divider"></div>
        <p>A microservices architecture designed for reliability, observability, and developer-friendly APIs.</p>
      </div>

      <!-- Architecture diagram placeholder -->
      <div class="arch-diagram card">
        <div class="arch-diagram__placeholder">
          <span>🏗️</span>
          <p class="text-muted">Architecture diagram coming soon</p>
          <p class="text-dim" style="font-size:var(--text-sm);">Will show: Client → Ocelot → [UserManagement | FishDex | AquaHome] → PostgreSQL</p>
        </div>
      </div>

      <!-- Stack breakdown -->
      <h2 style="margin-bottom:1.5rem; margin-top:3rem;">Tech Stack</h2>
      <div class="stack-list">
        {stack.map(item => (
          <div class="stack-item card">
            <div class="stack-item__left">
              <span class="stack-item__layer text-dim">{item.layer}</span>
              <h3 class="stack-item__tech">{item.tech}</h3>
            </div>
            <p class="stack-item__desc text-muted">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .arch-diagram {
    margin-bottom: 1rem;
  }

  .arch-diagram__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 3rem;
    text-align: center;
  }

  .arch-diagram__placeholder span {
    font-size: 3rem;
    line-height: 1;
  }

  .stack-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stack-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
    align-items: center;
    padding: 1.5rem 1.75rem;
  }

  .stack-item__layer {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .stack-item__tech {
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--c-white);
  }

  .stack-item__desc {
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .stack-item {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }
  }
</style>
